    // Load game from URL param
    const params = new URLSearchParams(window.location.search);
    const gameKey = params.get('game') || 'mobile-legends';
    const game = gamePackages[gameKey] || gamePackages['mobile-legends'];

    // Set title
    document.getElementById('orderTitle').innerHTML =
      `Top Up <span class="highlight">${game.name}</span>`;
    document.title = `Order ${game.name} — DEN TOPUP`;

    // Show server field if needed
    if (game.server) {
      document.getElementById('serverGroup').style.display = '';
    }

    // Render packages
    const grid = document.getElementById('packagesGrid');
    let selectedPkg = null;
    game.packages.forEach((pkg, i) => {
      const btn = document.createElement('div');
      btn.className = 'pkg-btn';
      btn.innerHTML = `<div class="pkg-amount">${pkg.amount}</div><div class="pkg-label">${pkg.label}</div><div class="pkg-price">${pkg.price}</div>`;
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pkg-btn').forEach(b => b.classList.remove('selected'));
        btn.classList.add('selected');
        selectedPkg = pkg;
      });
      grid.appendChild(btn);
    });

    // Submit order
    function submitOrder() {
      const userId = document.getElementById('userId').value.trim();
      const payMethod = document.getElementById('payMethod').value;
      const whatsapp = document.getElementById('whatsappNum').value.trim();

      if (!userId) { alert('Please enter your Game ID.'); return; }
      if (!selectedPkg) { alert('Please choose a package.'); return; }
      if (!payMethod) { alert('Please select a payment method.'); return; }
      if (!whatsapp) { alert('Please enter your WhatsApp number.'); return; }

      document.getElementById('successBox').style.display = 'block';
      document.getElementById('successBox').scrollIntoView({ behavior: 'smooth' });
    }
