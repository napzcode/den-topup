<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order — DEN TOPUP</title>
  <link rel="stylesheet" href="style.css" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <style>
    .order-page { min-height: 100vh; padding: 100px 24px 60px; max-width: 680px; margin: 0 auto; }
    .order-back { display: inline-flex; align-items: center; gap: 8px; color: var(--pink); font-size: 0.9rem; font-weight: 600; margin-bottom: 32px; transition: gap 0.2s; }
    .order-back:hover { gap: 12px; }
    .order-header { margin-bottom: 32px; }
    .order-header h1 { font-size: 1.8rem; font-weight: 800; margin-bottom: 6px; }
    .order-header p { color: var(--text-muted); font-size: 0.9rem; }
    .order-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px; margin-bottom: 24px; }
    .order-card h2 { font-size: 1rem; font-weight: 700; color: var(--pink-light); margin-bottom: 20px; display: flex; align-items: center; gap: 8px; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 0.82rem; font-weight: 600; color: #ccc; margin-bottom: 8px; }
    .form-group input, .form-group select {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 12px 16px;
      color: white;
      font-family: var(--font);
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .form-group input:focus, .form-group select:focus { border-color: var(--pink); }
    .form-group select option { background: #1e1e2e; }
    .packages-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
    .pkg-btn {
      background: rgba(255,255,255,0.04);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px 10px;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
    }
    .pkg-btn:hover { border-color: var(--pink); background: rgba(255,107,181,0.08); transform: scale(1.03); }
    .pkg-btn.selected { border-color: var(--pink); background: rgba(255,107,181,0.15); }
    .pkg-btn .pkg-amount { font-size: 1rem; font-weight: 800; color: var(--white); }
    .pkg-btn .pkg-label { font-size: 0.7rem; color: var(--text-muted); margin-top: 2px; }
    .pkg-btn .pkg-price { font-size: 0.82rem; font-weight: 700; color: var(--pink); margin-top: 6px; }
    .submit-btn {
      width: 100%;
      background: linear-gradient(135deg, var(--pink), var(--pink-dark));
      color: white;
      border: none;
      padding: 16px;
      border-radius: var(--radius-sm);
      font-family: var(--font);
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 6px 24px rgba(255,107,181,0.35);
      transition: opacity 0.2s, transform 0.15s;
    }
    .submit-btn:hover { opacity: 0.9; transform: translateY(-2px); }
    .order-note { font-size: 0.78rem; color: var(--text-muted); text-align: center; margin-top: 14px; line-height: 1.6; }
    .success-box { display: none; background: rgba(37,211,102,0.12); border: 1px solid rgba(37,211,102,0.3); border-radius: var(--radius); padding: 24px; text-align: center; margin-top: 20px; }
    .success-box .success-icon { font-size: 2.5rem; }
    .success-box h3 { font-size: 1.1rem; font-weight: 700; margin: 10px 0 6px; color: #25d366; }
    .success-box p { font-size: 0.85rem; color: #aaa; }
  </style>
</head>
<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="index.html" class="logo">
        <span class="logo-den">DEN</span><span class="logo-topup">TOPUP</span>
        <span class="logo-star">✦</span>
      </a>
      <div class="nav-socials" style="margin-left:auto">
        <a href="https://discord.gg/YOUR_DISCORD_INVITE" target="_blank" class="btn-social discord">
          <i class="fa-brands fa-discord"></i> Discord
        </a>
        <a href="https://chat.whatsapp.com/YOUR_WHATSAPP_INVITE" target="_blank" class="btn-social whatsapp">
          <i class="fa-brands fa-whatsapp"></i> WhatsApp
        </a>
      </div>
    </div>
  </nav>

  <!-- FLOATING SOCIALS -->
  <div class="floating-socials">
    <a href="https://discord.gg/YOUR_DISCORD_INVITE" target="_blank" class="float-btn float-discord" title="Discord">
      <i class="fa-brands fa-discord"></i><span>Discord</span>
    </a>
    <a href="https://chat.whatsapp.com/YOUR_WHATSAPP_INVITE" target="_blank" class="float-btn float-whatsapp" title="WhatsApp">
      <i class="fa-brands fa-whatsapp"></i><span>WhatsApp</span>
    </a>
  </div>

  <div class="order-page">
    <a href="index.html" class="order-back"><i class="fa-solid fa-arrow-left"></i> Back to Games</a>

    <div class="order-header">
      <h1 id="orderTitle">Top Up <span class="highlight">Game</span></h1>
      <p>Fill in your details and choose a package below.</p>
    </div>

    <!-- GAME ID -->
    <div class="order-card">
      <h2><i class="fa-solid fa-gamepad"></i> Player Info</h2>
      <div class="form-group">
        <label for="userId">Game ID / User ID</label>
        <input type="text" id="userId" placeholder="Enter your Game ID" />
      </div>
      <div class="form-group" id="serverGroup" style="display:none">
        <label for="serverId">Server ID (if required)</label>
        <input type="text" id="serverId" placeholder="e.g. 1234" />
      </div>
    </div>

    <!-- PACKAGES -->
    <div class="order-card">
      <h2><i class="fa-solid fa-gem"></i> Choose Package</h2>
      <div class="packages-grid" id="packagesGrid">
        <!-- Packages injected by JS -->
      </div>
    </div>

    <!-- PAYMENT -->
    <div class="order-card">
      <h2><i class="fa-solid fa-credit-card"></i> Payment Method</h2>
      <div class="form-group">
        <label for="payMethod">Select Payment</label>
        <select id="payMethod">
          <option value="">-- Choose --</option>
          <option>Bank Transfer (BCA)</option>
          <option>Bank Transfer (Mandiri)</option>
          <option>DANA</option>
          <option>GoPay</option>
          <option>OVO</option>
          <option>ShopeePay</option>
          <option>QRIS</option>
          <option>Indomaret / Alfamart</option>
        </select>
      </div>
      <div class="form-group">
        <label for="whatsappNum">WhatsApp Number (for order confirmation)</label>
        <input type="text" id="whatsappNum" placeholder="+62 812 xxxx xxxx" />
      </div>
    </div>

    <button class="submit-btn" onclick="submitOrder()">
      <i class="fa-solid fa-bolt"></i> Submit Order
    </button>
    <p class="order-note">After submitting, our team will contact you on WhatsApp to confirm your order. Orders are usually processed within 1–5 minutes. Need help? Join our <a href="https://discord.gg/YOUR_DISCORD_INVITE" target="_blank" style="color:var(--pink)">Discord</a> or <a href="https://chat.whatsapp.com/YOUR_WHATSAPP_INVITE" target="_blank" style="color:#25d366">WhatsApp</a>.</p>

    <div class="success-box" id="successBox">
      <div class="success-icon">✅</div>
      <h3>Order Submitted!</h3>
      <p>Thank you! We'll contact you on WhatsApp shortly to process your top-up.</p>
    </div>
  </div>

