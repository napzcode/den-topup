/* ===== ROOT VARIABLES ===== */
:root {
  --pink: #ff6bb5;
  --pink-light: #ffb3d9;
  --pink-soft: #fff0f7;
  --pink-dark: #d63384;
  --black: #0d0d0d;
  --dark: #1a1a2e;
  --dark2: #16213e;
  --card-bg: #1e1e2e;
  --white: #ffffff;
  --text-muted: #aaa;
  --border: rgba(255,107,181,0.2);
  --shadow: 0 8px 32px rgba(255,107,181,0.15);
  --radius: 18px;
  --radius-sm: 10px;
  --font: 'Poppins', sans-serif;
}

/* ===== RESET ===== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }
body {
  font-family: var(--font);
  background: var(--dark);
  color: var(--white);
  overflow-x: hidden;
}
a { text-decoration: none; color: inherit; }
ul { list-style: none; }
img { max-width: 100%; display: block; }

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar { width: 7px; }
::-webkit-scrollbar-track { background: var(--dark); }
::-webkit-scrollbar-thumb { background: var(--pink); border-radius: 99px; }

/* ===== NAVBAR ===== */
.navbar {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(13,13,13,0.85);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}
.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  height: 68px;
  display: flex;
  align-items: center;
  gap: 32px;
}
.logo {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 1px;
  display: flex;
  align-items: center;
  gap: 2px;
}
.logo-den { color: var(--white); }
.logo-topup { color: var(--pink); }
.logo-star { color: var(--pink); font-size: 0.8rem; margin-left: 4px; }
.nav-links {
  display: flex;
  gap: 28px;
  margin-left: auto;
}
.nav-links a {
  font-size: 0.9rem;
  font-weight: 500;
  color: #ccc;
  transition: color 0.2s;
  position: relative;
  padding-bottom: 2px;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0;
  width: 0; height: 2px;
  background: var(--pink);
  border-radius: 99px;
  transition: width 0.25s;
}
.nav-links a:hover { color: var(--pink); }
.nav-links a:hover::after { width: 100%; }
.nav-socials { display: flex; gap: 10px; }
.btn-social {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  border-radius: 99px;
  font-size: 0.82rem;
  font-weight: 600;
  transition: transform 0.2s, box-shadow 0.2s;
  white-space: nowrap;
}
.btn-social:hover { transform: translateY(-2px); }
.discord {
  background: linear-gradient(135deg, #5865f2, #7289da);
  color: white;
  box-shadow: 0 4px 15px rgba(88,101,242,0.4);
}
.whatsapp {
  background: linear-gradient(135deg, #25d366, #128c7e);
  color: white;
  box-shadow: 0 4px 15px rgba(37,211,102,0.4);
}
.hamburger {
  display: none;
  background: none;
  border: none;
  color: var(--pink);
  font-size: 1.4rem;
  cursor: pointer;
  margin-left: auto;
}
.mobile-menu {
  display: none;
  flex-direction: column;
  padding: 16px 24px 20px;
  gap: 14px;
  border-top: 1px solid var(--border);
}
.mobile-menu a {
  font-size: 0.95rem;
  font-weight: 500;
  color: #ccc;
  transition: color 0.2s;
}
.mobile-menu a:hover { color: var(--pink); }
.mobile-menu.open { display: flex; }

/* ===== HERO ===== */
.hero {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120px 24px 80px;
  position: relative;
  overflow: hidden;
  text-align: center;
}
.hero-bg-circles { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
.circle {
  position: absolute;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.25;
}
.c1 { width: 500px; height: 500px; background: var(--pink); top: -100px; left: -150px; }
.c2 { width: 400px; height: 400px; background: var(--pink-dark); bottom: -80px; right: -100px; }
.c3 { width: 300px; height: 300px; background: #ff9de2; top: 50%; left: 50%; transform: translate(-50%,-50%); }
.hero-content { position: relative; z-index: 1; max-width: 700px; }
.hero-badge {
  display: inline-block;
  background: rgba(255,107,181,0.15);
  border: 1px solid var(--border);
  color: var(--pink-light);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 2px;
  padding: 6px 18px;
  border-radius: 99px;
  margin-bottom: 20px;
}
.hero h1 {
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  line-height: 1.15;
  margin-bottom: 18px;
}
.highlight {
  background: linear-gradient(90deg, var(--pink), var(--pink-dark));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero p {
  font-size: 1.05rem;
  color: #bbb;
  line-height: 1.7;
  margin-bottom: 32px;
}
.hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
.btn-primary {
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: white;
  padding: 14px 32px;
  border-radius: 99px;
  font-weight: 700;
  font-size: 0.95rem;
  box-shadow: 0 6px 24px rgba(255,107,181,0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}
.btn-primary:hover { transform: translateY(-3px); box-shadow: 0 10px 32px rgba(255,107,181,0.5); }
.btn-outline {
  border: 2px solid var(--pink);
  color: var(--pink);
  padding: 12px 30px;
  border-radius: 99px;
  font-weight: 700;
  font-size: 0.95rem;
  transition: background 0.2s, color 0.2s, transform 0.2s;
}
.btn-outline:hover { background: var(--pink); color: white; transform: translateY(-3px); }
.hero-img {
  display: flex;
  gap: 16px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 52px;
  position: relative;
  z-index: 1;
}
.hero-card {
  background: rgba(255,255,255,0.05);
  border: 1px solid var(--border);
  backdrop-filter: blur(12px);
  border-radius: var(--radius);
  padding: 20px 28px;
  display: flex;
  align-items: center;
  gap: 14px;
  transition: transform 0.2s;
}
.hero-card:hover { transform: translateY(-4px); }
.hero-card-icon { font-size: 1.8rem; }
.hero-card-text { display: flex; flex-direction: column; }
.hero-card-text span { font-size: 0.75rem; color: var(--text-muted); }
.hero-card-text strong { font-size: 0.95rem; color: var(--white); }

/* ===== FLOATING SOCIALS ===== */
.floating-socials {
  position: fixed;
  right: 20px;
  bottom: 30px;
  z-index: 999;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.float-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 18px;
  border-radius: 99px;
  font-size: 0.85rem;
  font-weight: 700;
  box-shadow: 0 6px 20px rgba(0,0,0,0.3);
  transition: transform 0.2s, box-shadow 0.2s;
  overflow: hidden;
  max-width: 50px;
  transition: max-width 0.3s ease, padding 0.3s ease, transform 0.2s;
  white-space: nowrap;
}
.float-btn span { opacity: 0; transition: opacity 0.2s; }
.float-btn:hover { max-width: 160px; transform: translateX(-4px); }
.float-btn:hover span { opacity: 1; }
.float-discord { background: linear-gradient(135deg, #5865f2, #7289da); color: white; }
.float-whatsapp { background: linear-gradient(135deg, #25d366, #128c7e); color: white; }
.float-btn i { font-size: 1.2rem; flex-shrink: 0; }

/* ===== SECTION COMMON ===== */
section { padding: 90px 24px; }
.section-header { text-align: center; margin-bottom: 52px; }
.section-badge {
  display: inline-block;
  background: rgba(255,107,181,0.12);
  border: 1px solid var(--border);
  color: var(--pink);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 5px 16px;
  border-radius: 99px;
  margin-bottom: 12px;
}
.section-header h2 {
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  font-weight: 800;
  margin-bottom: 12px;
}
.section-header p { color: var(--text-muted); font-size: 0.95rem; max-width: 520px; margin: 0 auto; }

/* ===== SEARCH ===== */
.search-bar {
  max-width: 440px;
  margin: 0 auto 40px;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.05);
  border: 1.5px solid var(--border);
  border-radius: 99px;
  padding: 10px 20px;
  gap: 10px;
  transition: border-color 0.2s;
}
.search-bar:focus-within { border-color: var(--pink); }
.search-bar i { color: var(--pink); }
.search-bar input {
  background: none;
  border: none;
  outline: none;
  color: white;
  font-family: var(--font);
  font-size: 0.9rem;
  flex: 1;
}
.search-bar input::placeholder { color: #666; }

/* ===== GAMES GRID ===== */
.games-section { max-width: 1200px; margin: 0 auto; }
.games-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 22px;
}
.game-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
}
.game-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 40px rgba(255,107,181,0.2);
  border-color: var(--pink);
}
.game-card-img {
  height: 140px;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
}
/* Game cover images — sourced from Wikipedia Commons & official stores */
.game-card-img.ml {
  background-image: url('images/ml.jpg'),
                    linear-gradient(135deg, #1a1a2e 0%, #e94560 50%, #ff6bb5 100%);
  background-size: cover;
  background-position: center top;
}
.game-card-img.cod {
  background-image: url('images/cod.jpg'),
                    linear-gradient(135deg, #0d0d0d 0%, #3a3a3a 50%, #f5a623 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.genshin {
  background-image: url('images/genshin.jpg'),
                    linear-gradient(135deg, #1a1a6e 0%, #6a5acd 50%, #c0c0ff 100%);
  background-size: cover;
  background-position: center top;
}
.game-card-img.ff {
  background-image: url('images/ff.jpg'),
                    linear-gradient(135deg, #0d2b0d 0%, #1e7a1e 50%, #ffcc00 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.pw {
  background-image: url('images/pw.jpg'),
                    linear-gradient(135deg, #1a2a4a 0%, #2196f3 50%, #64b5f6 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.gt {
  background-image: url('images/gt.jpg'),
                    linear-gradient(135deg, #2d5a1b 0%, #4caf50 50%, #a5d6a7 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.bs {
  background-image: url('images/bs.jpg'),
                    linear-gradient(135deg, #1a0000 0%, #8b0000 50%, #ff4444 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.val {
  background-image: url('images/val.jpg'),
                    linear-gradient(135deg, #0f0f0f 0%, #ff4655 50%, #ff6b6b 100%);
  background-size: cover;
  background-position: center top;
}
.game-card-img.pubg {
  background-image: url('images/pubg.jpg'),
                    linear-gradient(135deg, #1a1200 0%, #c8a400 50%, #f5d800 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.hsr {
  background-image: url('images/hsr.jpg'),
                    linear-gradient(135deg, #0a0a2e 0%, #4b0082 50%, #9b59b6 100%);
  background-size: cover;
  background-position: center top;
}
.game-card-img.wr {
  background-image: url('images/wr.jpg'),
                    linear-gradient(135deg, #0d1b2a 0%, #1f6e9c 50%, #00c8ff 100%);
  background-size: cover;
  background-position: center;
}
.game-card-img.coc {
  background-image: url('images/coc.jpg'),
                    linear-gradient(135deg, #1a0f00 0%, #8b4513 50%, #d2691e 100%);
  background-size: cover;
  background-position: center;
}

.game-card-img::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, transparent 30%, rgba(30,30,46,0.92) 100%);
  z-index: 1;
}
.game-cover-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center top;
  z-index: 0;
  transition: transform 0.4s ease;
}
.game-card:hover .game-cover-img {
  transform: scale(1.06);
}
.game-card-body { padding: 16px; }
.game-card-body h3 { font-size: 0.95rem; font-weight: 700; margin-bottom: 4px; }
.game-card-body > p { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 10px; }
.game-tags { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
.game-tags span {
  font-size: 0.68rem;
  font-weight: 600;
  padding: 3px 10px;
  border-radius: 99px;
  background: rgba(255,107,181,0.15);
  color: var(--pink-light);
  border: 1px solid rgba(255,107,181,0.25);
}
.btn-order {
  display: block;
  text-align: center;
  background: linear-gradient(135deg, var(--pink), var(--pink-dark));
  color: white;
  padding: 10px;
  border-radius: var(--radius-sm);
  font-size: 0.82rem;
  font-weight: 700;
  transition: opacity 0.2s, transform 0.2s;
}
.btn-order:hover { opacity: 0.88; transform: scale(0.98); }

/* ===== HOW TO ORDER ===== */
.how-section { background: rgba(255,107,181,0.04); }
.steps-grid {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}
.step-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 32px 28px;
  text-align: center;
  flex: 1;
  min-width: 180px;
  max-width: 240px;
  transition: transform 0.2s, border-color 0.2s;
  position: relative;
}
.step-card:hover { transform: translateY(-5px); border-color: var(--pink); }
.step-num {
  position: absolute;
  top: -14px; right: 16px;
  font-size: 2.5rem;
  font-weight: 800;
  color: rgba(255,107,181,0.12);
  line-height: 1;
}
.step-icon { font-size: 2.4rem; margin-bottom: 12px; }
.step-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: var(--pink-light); }
.step-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }
.step-arrow { font-size: 1.6rem; color: var(--pink); flex-shrink: 0; }

/* ===== WHY SECTION ===== */
.why-section { max-width: 1200px; margin: 0 auto; padding: 60px 24px 90px; }
.why-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 22px;
}
.why-card {
  background: var(--card-bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 30px 24px;
  text-align: center;
  transition: transform 0.2s, border-color 0.2s;
}
.why-card:hover { transform: translateY(-5px); border-color: var(--pink); }
.why-icon { font-size: 2.2rem; margin-bottom: 14px; }
.why-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; color: var(--pink-light); }
.why-card p { font-size: 0.82rem; color: var(--text-muted); line-height: 1.6; }

/* ===== CONTACT ===== */
.contact-section { background: rgba(255,107,181,0.04); }
.contact-grid {
  max-width: 760px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}
.contact-card {
  border-radius: var(--radius);
  padding: 36px 28px;
  text-align: center;
  transition: transform 0.25s, box-shadow 0.25s;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}
.contact-card:hover { transform: translateY(-6px); }
.contact-card i { font-size: 2.8rem; }
.contact-card h3 { font-size: 1.1rem; font-weight: 700; }
.contact-card p { font-size: 0.83rem; color: rgba(255,255,255,0.75); line-height: 1.6; max-width: 240px; }
.contact-btn {
  margin-top: 8px;
  display: inline-block;
  padding: 10px 24px;
  border-radius: 99px;
  font-size: 0.85rem;
  font-weight: 700;
  background: rgba(255,255,255,0.15);
  transition: background 0.2s;
}
.contact-card:hover .contact-btn { background: rgba(255,255,255,0.25); }
.discord-card {
  background: linear-gradient(135deg, rgba(88,101,242,0.3), rgba(114,137,218,0.2));
  border: 1px solid rgba(88,101,242,0.4);
  color: white;
  box-shadow: 0 8px 30px rgba(88,101,242,0.15);
}
.whatsapp-card {
  background: linear-gradient(135deg, rgba(37,211,102,0.3), rgba(18,140,126,0.2));
  border: 1px solid rgba(37,211,102,0.4);
  color: white;
  box-shadow: 0 8px 30px rgba(37,211,102,0.15);
}

/* ===== FOOTER ===== */
.footer {
  background: #0a0a0a;
  border-top: 1px solid var(--border);
  padding: 60px 24px 0;
}
.footer-content {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 40px;
  padding-bottom: 40px;
}
.footer-logo .logo-den { font-size: 1.4rem; font-weight: 800; color: white; }
.footer-logo .logo-topup { font-size: 1.4rem; font-weight: 800; color: var(--pink); }
.footer-logo p { font-size: 0.85rem; color: var(--text-muted); margin-top: 10px; line-height: 1.6; }
.footer-socials { display: flex; gap: 12px; margin-top: 18px; }
.footer-socials a {
  width: 38px; height: 38px;
  background: rgba(255,255,255,0.07);
  border: 1px solid var(--border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1rem;
  color: var(--text-muted);
  transition: background 0.2s, color 0.2s, transform 0.2s;
}
.footer-socials a:hover { background: var(--pink); color: white; transform: scale(1.1); border-color: var(--pink); }
.footer-links h4, .footer-games h4 {
  font-size: 0.9rem;
  font-weight: 700;
  color: var(--pink-light);
  margin-bottom: 16px;
  letter-spacing: 0.5px;
}
.footer-links ul li, .footer-games ul li { margin-bottom: 10px; }
.footer-links ul li a, .footer-games ul li a {
  font-size: 0.85rem;
  color: var(--text-muted);
  transition: color 0.2s;
}
.footer-links ul li a:hover, .footer-games ul li a:hover { color: var(--pink); }
.footer-bottom {
  border-top: 1px solid var(--border);
  padding: 20px 0;
  text-align: center;
  font-size: 0.82rem;
  color: #555;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 900px) {
  .nav-links, .nav-socials { display: none; }
  .hamburger { display: block; }
  .footer-content { grid-template-columns: 1fr 1fr; }
  .footer-logo { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .contact-grid { grid-template-columns: 1fr; }
  .footer-content { grid-template-columns: 1fr; }
  .hero-img { flex-direction: column; align-items: center; }
  .steps-grid { flex-direction: column; }
  .step-arrow { transform: rotate(90deg); }
  .games-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
  .float-btn { padding: 12px; max-width: 50px; }
  .float-btn span { display: none; }
}
